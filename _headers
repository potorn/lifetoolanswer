# AdSense and CSP
# Google only documents a nonce strict CSP (script-src with a per-response nonce,
# strict-dynamic, and an https: / http: fallback). Static files cannot mint that nonce.
# strict-dynamic without a nonce would ignore this allowlist and block adsbygoogle.js.
# script-src and connect-src therefore list the Google ad hosts (plus wildcards, because
# the host list changes). script-src also allows 'unsafe-inline' so the official inline
# adsbygoogle.push snippet is not blocked once an ad unit is added.
# frame-src and img-src are https: because there was no frame-src (so frames fell back
# to default-src 'self' and every ad iframe was blocked) and impression images are not
# limited to one host. Ad creatives run in those frames. wasm-unsafe-eval stays for the
# on-page image and GIF tools. object-src, base-uri, frame-ancestors, and form-action
# stay tight.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://pagead2.googlesyndication.com https://tpc.googlesyndication.com https://www.googletagservices.com https://adservice.google.com https://www.googleadservices.com https://partner.googleadservices.com https://www.google.com https://www.gstatic.com https://fundingchoicesmessages.google.com https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google https://securepubads.g.doubleclick.net https://googleads.g.doubleclick.net https://*.googlesyndication.com https://*.googletagservices.com https://*.googleadservices.com https://*.google.com https://*.gstatic.com https://*.googleapis.com https://*.doubleclick.net https://*.g.doubleclick.net https://*.adtrafficquality.google; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' blob: data: https:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' blob: https://pagead2.googlesyndication.com https://adservice.google.com https://csi.gstatic.com https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google https://www.google.com https://*.google.com https://*.googleapis.com https://*.gstatic.com https://*.googlesyndication.com https://*.googleadservices.com https://*.googletagservices.com https://*.doubleclick.net https://*.g.doubleclick.net https://*.adtrafficquality.google; frame-src https:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Referrer-Policy: strict-origin-when-cross-origin
